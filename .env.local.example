# Copy to `.env.local` (git-ignored) and point it at the plugin folder of the
# vault you develop against. Every successful build copies main.js,
# manifest.json and styles.css there, plus the `.hotreload` marker that tells the
# Hot Reload plugin to reload it. Then `pnpm dev` needs no arguments.
#
# Copying, not symlinking: a symlink would put this repo's node_modules and .git
# inside a vault that iCloud or Dropbox is watching.

OBSIDIAN_DEPLOY_TO=/Users/you/Library/Mobile Documents/iCloud~md~obsidian/Documents/YourVault/.obsidian/plugins/simple-tasks
