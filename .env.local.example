# Copy to `.env.local` (git-ignored) and list the vaults you develop against, as
# vault *roots*. The plugin subfolder is derived from the manifest id, so this
# same file works unchanged for every plugin you build.
#
# The name after VAULT_ is yours to choose; it is what `--vault=` takes.

VAULT_TEST=/Users/you/dev/my-obsidian-plugins
VAULT_REAL=/Users/you/Library/Mobile Documents/iCloud~md~obsidian/Documents/YourVault

# Used when no --vault= is given.
VAULT_DEFAULT=TEST

# Then:
#   pnpm dev                    watch and reinstall on every save, into VAULT_DEFAULT
#   pnpm dev --vault=real       the same, into VAULT_REAL
#   pnpm install:vault --vault=real   one production build, installed there
#
# `pnpm build` never writes to a vault: that is the CI path.
#
# Each install copies main.js, manifest.json and styles.css, plus a `.hotreload`
# marker so the Hot Reload plugin reloads it without restarting Obsidian. Copying,
# not symlinking: a symlink would put node_modules and .git inside a synced vault.
# If a vault already reaches this repo through a symlink, the install is skipped.
