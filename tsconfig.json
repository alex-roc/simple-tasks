{
	"compilerOptions": {
		"noEmit": true,
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2021",
		"strict": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"moduleResolution": "node",
		"isolatedModules": true,
		// Relative imports carry an explicit .ts extension so `node --test` can run the
		// domain unit tests with native type stripping, no extra dependency.
		"allowImportingTsExtensions": true,
		// Forces `import type` for type-only imports, which is what keeps `domain/`
		// runnable outside Obsidian.
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"allowSyntheticDefaultImports": true,
		"lib": ["ES2021", "DOM"]
	},
	"include": ["src/**/*.ts"]
}
