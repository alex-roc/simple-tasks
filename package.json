{
	"name": "simple-tasks",
	"version": "0.1.0",
	"description": "Obsidian plugin for task management on plain markdown checkboxes",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "node --test \"src/**/*.test.ts\"",
		"seed": "node scripts/seed-vault.mjs",
		"verify": "node scripts/verify-vault.ts",
		"install:vault": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production deploy",
		"dev:vault": "node esbuild.config.mjs deploy"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tasks"
	],
	"license": "MIT",
	"packageManager": "pnpm@11.17.0",
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
